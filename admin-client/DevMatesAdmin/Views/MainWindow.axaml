<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DevMatesAdmin.Views.MainWindow"
        Title="DevMates — Tableau de bord administrateur"
        Width="980"
        Height="620"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <!-- ── Barre d'outils (bas) ── -->
        <Border DockPanel.Dock="Bottom"
                Background="#F8F9FA"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <DockPanel>

                <!-- Statut à droite -->
                <TextBlock x:Name="LblStatut"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Foreground="#718096"
                           Margin="0,0,8,0"/>

                <!-- Boutons d'action -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="↻  Actualiser"
                            Padding="14,8"
                            Click="BtnActualiser_Click"/>
                    <Button Content="●  Activer / Désactiver"
                            Padding="14,8"
                            Click="BtnToggle_Click"/>
                    <Button Content="⛔  Bannir"
                            Padding="14,8"
                            Click="BtnBannir_Click"/>
                    <Button Content="✕  Supprimer"
                            Padding="14,8"
                            Click="BtnSupprimer_Click"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ── Tableau des utilisateurs ── -->
        <DataGrid x:Name="GrilleUtilisateurs"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  AutoGenerateColumns="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  GridLinesVisibility="Horizontal">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="55"/>
                <DataGridTextColumn Header="Nom"
                                    Binding="{Binding NomAffiche}"
                                    Width="160"/>
                <DataGridTextColumn Header="Email"
                                    Binding="{Binding Email}"
                                    Width="*"/>
                <DataGridTextColumn Header="Rôle"
                                    Binding="{Binding RoleLibelle}"
                                    Width="155"/>
                <DataGridTextColumn Header="Actif"
                                    Binding="{Binding EstActifLibelle}"
                                    Width="80"/>
                <DataGridTextColumn Header="Banni"
                                    Binding="{Binding EstBanniLibelle}"
                                    Width="80"/>
                <DataGridTextColumn Header="Inscription"
                                    Binding="{Binding CreatedAt}"
                                    Width="165"/>
            </DataGrid.Columns>

        </DataGrid>

    </DockPanel>

</Window>
