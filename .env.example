# ── Variables d'environnement DevMates ──
# Copier ce fichier en .env et adapter les valeurs avant de lancer docker-compose

# Base de données MySQL
MYSQL_ROOT_PASSWORD=root_secret_a_changer
DB_USER=devmates_user
DB_PASSWORD=devmates_secret_a_changer

# Clé secrète de signature JWT (minimum 32 caractères, aléatoire en production)
JWT_SECRET=remplacez_par_une_cle_aleatoire_securisee_32_chars_min
